# Copie para backend/.env e ajuste conforme o ambiente.

# Conexão com o daemon Docker (vazio = ambiente padrão)
DOCKER_HOST=unix:///var/run/docker.sock
# Timeout padrão de comandos executados nos containers (segundos)
DOCKER_TIMEOUT_SECONDS=30

# Diretório local dos runs (montado como /verilog_code nos containers)
VERILOG_RUNS_DIR=/verilog_code/runs

# Yosys: nome do container e tempo limite da síntese (segundos)
YOSYS_CONTAINER_NAME=yosys
YOSYS_TIMEOUT_SECONDS=30

# Icarus Verilog: nome do container, tempo limite da simulação (segundos)
# e caminho do script de simulação dentro do container
ICARUS_CONTAINER_NAME=icarus-verilog
ICARUS_TIMEOUT_SECONDS=30
ICARUS_SCRIPT_PATH=/scripts/simular.sh

# Limites do VCD devolvido em /simular-execucao. Acima deles a resposta é
# truncada e sinalizada em simulation_log.metadata (truncated/truncation_reason).
VCD_MAX_TIMESTAMPS=50000
VCD_MAX_SIGNALS=500
VCD_MAX_FILE_BYTES=104857600
