# Copie para .env e ajuste. Todas as variaveis sao lidas por config.py (Settings).

PROJECT_NAME="Verilog Classroom API"
API_V1_STR=/api/v1

# Origens liberadas no CORS, em formato JSON (lista de strings)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Daemon Docker (vazio = padrao do sistema). Ex.: unix:///var/run/docker.sock
# DOCKER_HOST=
DOCKER_TIMEOUT_SECONDS=30
YOSYS_CONTAINER_NAME=yosys
YOSYS_TIMEOUT_SECONDS=30
ICARUS_CONTAINER_NAME=icarus-verilog

# Volume compartilhado onde cada run e extraido
VERILOG_RUNS_DIR=/verilog_code/runs

# Readiness (GET /api/v1/status/)
HEALTH_TIMEOUT_SECONDS=5
HEALTH_CACHE_TTL_SECONDS=5
