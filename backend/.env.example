# Copie para .env e ajuste. Todas as variáveis são lidas por config.py.

# Docker
# DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_TIMEOUT_SECONDS=30
YOSYS_CONTAINER_NAME=yosys
YOSYS_TIMEOUT_SECONDS=30
ICARUS_CONTAINER_NAME=icarus-verilog

# Diretório onde cada run é extraído (volume compartilhado com os containers)
VERILOG_RUNS_DIR=/verilog_code/runs

# Readiness (GET /api/v1/status/)
HEALTH_TIMEOUT_SECONDS=5
HEALTH_CACHE_TTL_SECONDS=5

# Limites do upload de ZIP (#9)
MAX_UPLOAD_BYTES=10485760          # 10 MB: tamanho máximo do arquivo enviado
MAX_UNCOMPRESSED_BYTES=52428800    # 50 MB: total realmente escrito na extração
MAX_ZIP_ENTRIES=500                # número máximo de entradas no ZIP
MAX_ZIP_DEPTH=8                    # níveis máximos de pastas
MAX_ZIP_PATH_LENGTH=255            # comprimento máximo de um caminho dentro do ZIP
MAX_COMPRESSION_RATIO=200          # razão máxima por entrada (só avaliada acima de 1 MB)

# Autorização (#8): token exigido no header X-Admin-Token de POST /verilog/limpar.
# Deixe vazio/comentado para desabilitar a rota (responde 404). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=

# Retenção dos runs (#10)
RUN_TTL_HOURS=6                    # horas sem uso até o run ser apagado (0 = sem expiração)
RUNS_MAX_TOTAL_BYTES=0             # teto de espaço dos runs; 0 = sem teto
GC_INTERVAL_MINUTES=30             # intervalo da coleta periódica; 0 = desliga a task
